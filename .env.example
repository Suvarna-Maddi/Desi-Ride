# Desi Ride Production Environment Configuration
NODE_ENV=production
PORT=4000

# Security & Tokens
JWT_SECRET=desiride-production-cryptographic-jwt-secret-replace-me-2026

# Database Storage Path (persist this directory via Docker volume)
DESIRIDE_DB_PATH=./server/data/desiride.db

# Real SMS Gateway Credentials (Required to send live SMS to Indian mobile numbers)
# Option A: Fast2SMS (India's leading transactional OTP gateway - https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option B: Twilio Cloud SMS (https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Real Email Delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Live Razorpay / Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_your_actual_key_here
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret_here

# Frontend API Configuration
VITE_API_BASE_URL=/api
